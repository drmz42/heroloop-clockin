<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: HeroLoop emblem on the brand dark, then MainActivity's launch
         screen keeps the emblem until the game UI is ready. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_dark</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:windowSplashScreenBackground">@color/brand_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
