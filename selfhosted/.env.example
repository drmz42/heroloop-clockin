# Copy only to the root-owned runtime secret path. Never commit real values.
POSTGRES_PASSWORD=GENERATE_URL_SAFE_RANDOM_VALUE
API_DATABASE_PASSWORD=GENERATE_SEPARATE_URL_SAFE_RANDOM_VALUE
WORKER_DATABASE_PASSWORD=GENERATE_SEPARATE_URL_SAFE_RANDOM_VALUE
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
JWT_KEYS=GENERATE_JSON_ARRAY_WITH_PRIVATE_ES256_AND_LEGACY_SYMMETRIC_JWKS
JWT_EXPIRY=3600
API_EXTERNAL_URL=https://staging.heroloop.xyz/auth/v1
SITE_URL=https://staging.heroloop.xyz
ADDITIONAL_REDIRECT_URLS=https://staging.heroloop.xyz/**
TESTER_CONTROLS_ENABLED=false
