    "searchExactIdentifiersOnlyNoBulkEnumeration": true,
    "supportNotesNoSecretsOrSpecialCategoryData": true,
    "exportPlayerRowsDisabled": true
  },
  "supportSession": {
    "silentLoginAsPlayerForbidden": true,
    "founderOnly": true,
    "reasonRequired": true,
    "stepUpRequired": true,
    "maximumMinutes": 15,
    "permanentVisibleBanner": true,
    "readOnlyByDefault": true,
    "blockedOperations": ["payment", "transfer", "economy-grant", "market", "account-delete", "credential-change", "security-change", "identity-link", "token-claim"],
    "automaticExpiryAndRevocation": true,
    "startAndEndAudited": true
  },
  "mutations": {
