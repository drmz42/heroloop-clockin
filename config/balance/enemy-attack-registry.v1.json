  "authority": {
    "presentationOnly": true,
    "combatOutcomeOwner": "server timeline",
    "rules": [
      "Attack presentation never changes attack timers, targets, damage, healing, rewards or resolution.",
      "Client staggering reorders only visual playback of already-decided server events; numeric outcome feedback is never withheld beyond the deferral cap.",
      "Every telegraph carries an icon and a text label; colour, motion and particles are never the only carrier of information.",
      "Maximum, Medium and Minimum receive identical combat state, target, telegraph identity and outcome."
    ]
  },
  "qualityModes": [
    {
      "id": "maximum",
      "label": "Maximum",
      "persistedValue": "spectacular",
      "gpuBudgetPercent": 20,
      "maxSimultaneousEnemyAttackAnimations": 3,
      "maxAnimatedLayersPerEnemy": 2,
      "particlesPerAttack": 12,
      "telegraphForm": "motion-frame-icon-label",
      "cameraShake": true
    },
    {
      "id": "medium",
      "label": "Medium",
      "persistedValue": "light",
      "gpuBudgetPercent": 12,
      "maxSimultaneousEnemyAttackAnimations": 2,
      "maxAnimatedLayersPerEnemy": 1,
      "particlesPerAttack": 4,
      "telegraphForm": "frame-icon-label",
      "cameraShake": false
    },
    {
      "id": "minimum",
      "label": "Minimum",
      "persistedValue": "off",
      "gpuBudgetPercent": 6,
      "maxSimultaneousEnemyAttackAnimations": 0,
      "maxAnimatedLayersPerEnemy": 0,
      "particlesPerAttack": 0,
      "telegraphForm": "static-icon-label",
      "cameraShake": false
    }
  ],
  "reducedMotion": "System Reduced Motion downgrades Maximum to the Medium telegraph form and removes nonessential travel; Minimum is unchanged.",
  "cadence": {
    "baselineAttackIntervalMs": 1540,
    "sourceOfTiming": "server combat timeline; the registry never supplies an interval",
    "visualStagger": {
      "minSpacingMs": 120,
      "maxDeferralMs": 360,
      "orderedBy": "server event sequence, then lane index",
      "appliesTo": "enemy attack presentation starting within the same 100 ms window"
    },
    "familyOffsetStepMs": 90,
    "deterministicJitterMs": [
      0,
      60
    ],
    "jitterSeed": "combat event id plus enemy uid; never Math.random",
    "hiddenTabPolicy": "no presentation is queued while the document is hidden; settlement continues without animation"
  },
  "telegraph": {
    "minLeadMsByRank": {
      "normal": 0,
      "veteran": 450,
      "elite": 450,
      "epic": 600,
      "field-boss": 800,
      "dungeon-boss": 900
    },
    "normalRankRule": "Normal enemies may attack without a separate telegraph; their archetype windup is the only cue.",
    "requiredFields": [
      "iconId",
      "label",
      "shape"
    ],
    "maxConcurrentTelegraphs": 3
  },
