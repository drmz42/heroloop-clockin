    "mandatory": true,
    "secretServerOnly": true,
    "tokenMaximumAgeSeconds": 300,
    "tokenSingleUse": true,
    "hostnameExactAllowlistRequired": true,
    "actionExactMatchRequired": true,
    "idempotencyKeyRequired": true,
    "remoteIpSentByDefault": false,
    "verificationTimeoutMilliseconds": 3000,
    "boundedRetryCount": 1,
    "siteverifySuccessStillRequiresAllOrdinaryAuthorization": true
  },
  "privacy": {
