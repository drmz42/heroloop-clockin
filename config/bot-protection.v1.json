    "heroLoopStoresChallengeToken": false,
    "heroLoopLogsIpOrFullUserAgentForChallenge": false,
    "storedFields": ["environment", "action", "outcome", "bounded_error_family", "day"],
    "minimumAggregateCohort": 5,
    "aggregateRetentionDays": 30,
    "providerAddendumReviewRequired": true,
    "privacyPolicyUpdateRequired": true,
    "ageAudienceReviewRequired": true
  },
  "failureStates": {
    "scriptBlocked": "show-accessible-retry-and-support-path-no-sensitive-action",
    "providerTimeout": "one-bounded-server-retry-then-no-sensitive-action",
    "invalidExpiredOrDuplicateToken": "fresh-challenge-required",
    "hostnameOrActionMismatch": "reject-and-alert",
    "providerOutage": "existing-sessions-and-ordinary-gameplay-continue-sensitive-challenged-actions-stop",
    "lowSolveRate": "disable-new-risk-rule-not-server-rate-limits-after-operator-review",
    "noClientSideBypass": true
  },
  "csp": {
    "scriptSrc": ["https://challenges.cloudflare.com"],
    "frameSrc": ["https://challenges.cloudflare.com"],
    "connectSrc": ["https://challenges.cloudflare.com"],
    "nonceBasedScriptPreferred": true,
    "noWildcardSource": true
  },
  "telemetry": {
    "metrics": ["issued", "solved", "failed", "expired", "duplicate", "provider_error", "latency_ms", "abandoned"],
    "dimensions": ["environment", "action", "day"],
    "alertOnHostnameOrActionMismatch": true,
    "alertOnProviderFailureRate": true,
    "noPlayerIdentifier": true
  },
  "acceptanceScenarios": [
    "valid-managed-token", "forged-token", "expired-token", "duplicate-token", "wrong-hostname", "wrong-action", "siteverify-timeout-retry-success", "siteverify-timeout-stop", "script-blocked", "keyboard-only", "screen-reader", "zoom-200-percent", "reduced-motion", "provider-outage-existing-session", "provider-outage-sensitive-action", "ordinary-gameplay-no-challenge", "rate-limit-still-enforced", "challenge-success-no-auth-bypass", "csp-allowlist", "privacy-log-redaction"
  ],
