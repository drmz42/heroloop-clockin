  "status": "proposal",
  "live": false,
  "selection": {
    "provider": "cloudflare-turnstile",
    "plan": "free",
    "mode": "managed",
    "provisional": true,
    "reasons": ["server-siteverify", "single-use-five-minute-token", "wcag-2.2", "no-cloudflare-cdn-requirement", "free-unlimited-challenges"],
    "recaptchaNotSelected": "free-tier-hard-limit-and-google-cloud-account-coupling",
    "paidPlanOrCostAuthorized": false
  },
  "scope": {
    "ordinaryPageView": false,
    "ordinaryAuthenticatedGameplay": false,
