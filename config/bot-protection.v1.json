    "riskTriggeredActions": ["account-create", "identity-link", "identity-recovery", "repeated-wallet-challenge", "pre-registration", "promo-abuse", "checkout-start"],
    "serverRateLimitsRemainPrimary": true,
    "challengeNeverAuthorizesAccountCurrencyRewardOrPurchase": true
